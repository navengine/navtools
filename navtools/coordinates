template <CoordType type, TangentFrame frame, typename Scalar>
class TangentCoord : public Eigen::Vector3<Scalar> {
 private:
  using EcefPos = EcefCoord<CoordType::POS, Scalar>;
  using EcefVel = EcefCoord<CoordType::VEL, Scalar>;
  using EcefAccel = EcefCoord<CoordType::ACCEL, Scalar>;
