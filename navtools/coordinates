  using EciVel = EciCoord<CoordType::VEL, Scalar>;
  using EciAccel = EciCoord<CoordType::ACCEL, Scalar>;
  using EciAngVel = EciCoord<CoordType::ANGVEL, Scalar>;
  using NedPos = TangentCoord<CoordType::POS, TangentFrame::NED, Scalar>;
  using NedVel = TangentCoord<CoordType::VEL, TangentFrame::NED, Scalar>;
  using NedAccel = TangentCoord<CoordType::ACCEL, TangentFrame::NED, Scalar>;
  using NedAngVel = TangentCoord<CoordType::ANGVEL, TangentFrame::NED, Scalar>;
  using EnuPos = TangentCoord<CoordType::POS, TangentFrame::ENU, Scalar>;
  using EnuVel = TangentCoord<CoordType::VEL, TangentFrame::ENU, Scalar>;
  using EnuAccel = TangentCoord<CoordType::ACCEL, TangentFrame::ENU, Scalar>;
  using EnuAngVel = TangentCoord<CoordType::ANGVEL, TangentFrame::ENU, Scalar>;

 public:
  /**
   * *=== TangentCoord ===*
   * @brief Default constructor. Initializes the vector to zeros.
   */
  explicit TangentCoord()
      : Eigen::Vector3<Scalar>() {
    this->setZero();
  }

  /**
   * *=== TangentCoord ===*
   * @brief Constructor that initializes the vector with given x, y, and z values.
   * @param x The x-component of the vector.
   * @param y The y-component of the vector.
   * @param z The z-component of the vector.
   */
  explicit TangentCoord(Scalar x, Scalar y, Scalar z)
      : Eigen::Vector3<Scalar>(x, y, z) {}

  /**
   * *=== TangentCoord ===*
   * @brief Constructor that initializes the vector from an Eigen::DenseBase object.
   * @tparam Derived The Eigen derived type.
   * @param vector The Eigen vector to copy from.
   */
  template <typename Derived>
  TangentCoord(const Eigen::DenseBase<Derived>& vector)
      : Eigen::Vector3<Scalar>() {
    ASSERT_EIGEN_SCALAR_TYPE(Derived, Scalar);
    ASSERT_EIGEN_VEC_SIZE(Derived, vector, 3);
    this->operator=(vector);
  }

  /**
   * *=== operator= ===*
   * @brief Assignment operator that copies from an Eigen::DenseBase object.
   * @tparam Derived The Eigen derived type.
   * @param other The Eigen vector to copy from.
   * @returns A reference to the current object.
   */
  template <typename Derived>
  TangentCoord& operator=(const Eigen::DenseBase<Derived>& other) {
    this->Eigen::Vector3<Scalar>::operator=(other);
    return *this;
  }

  Scalar& n() {
    if constexpr (frame == TangentFrame::NED) {
      return (*this)(0);
    } else if constexpr (frame == TangentFrame::ENU) {
      return (*this)(1);
    }
  }
  Scalar& e() {
    if constexpr (frame == TangentFrame::NED) {
      return (*this)(1);
    } else if constexpr (frame == TangentFrame::ENU) {
      return (*this)(0);
    }
  }
  auto d() -> Scalar& requires(frame == TangentFrame::NED) { return (*this)(2); }
  auto u() -> Scalar& requires(frame == TangentFrame::ENU) { return (*this)(2); }

  const Scalar& n() const {
    if constexpr (frame == TangentFrame::NED) {
      return (*this)(0);
    } else if constexpr (frame == TangentFrame::ENU) {
      return (*this)(1);
    }
  }
  const Scalar& e() const {
    if constexpr (frame == TangentFrame::NED) {
      return (*this)(1);
    } else if constexpr (frame == TangentFrame::ENU) {
      return (*this)(0);
    }
  }
  auto d() const -> const Scalar& requires(frame == TangentFrame::NED) { return (*this)(2); }
