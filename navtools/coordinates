#ifndef NAVTOOLS_COORDINATES_HPP
#define NAVTOOLS_COORDINATES_HPP

#include "navtools/core/acceleration-transforms.hpp"
#include "navtools/core/angular-rate-transforms.hpp"
#include "navtools/core/macros.hpp"
#include "navtools/core/position-transforms.hpp"
#include "navtools/core/velocity-transforms.hpp"
#include <Eigen/Dense>

namespace nt {

enum CoordType {
  POS,    // position
  VEL,    // velocity
  ACCEL,  // acceleration
  ANGVEL  // angular rate
};
enum TangentFrame {
  NED,  // North-East-Down
  ENU,  // East-North-Up
};

template <CoordType type, typename Scalar = double>
class EcefCoord;

template <CoordType type, typename Scalar = double>
class EciCoord;

template <CoordType type, TangentFrame frame, typename Scalar = double>
class TangentCoord;

template <bool degrees = false, typename Scalar = double>
class GeodeticCoord;

//! ============================================================================================ !//

template <CoordType type, typename Scalar>
class EcefCoord : public Eigen::Vector3<Scalar> {
 private:
  using EcefPos = EcefCoord<CoordType::POS, Scalar>;
  using EcefVel = EcefCoord<CoordType::VEL, Scalar>;
  using EcefAccel = EcefCoord<CoordType::ACCEL, Scalar>;
  using EcefAngVel = EcefCoord<CoordType::ANGVEL, Scalar>;
  using EciPos = EciCoord<CoordType::POS, Scalar>;
  using EciVel = EciCoord<CoordType::VEL, Scalar>;
  using EciAccel = EciCoord<CoordType::ACCEL, Scalar>;
  using EciAngVel = EciCoord<CoordType::ANGVEL, Scalar>;
  using NedPos = TangentCoord<CoordType::POS, TangentFrame::NED, Scalar>;
  using NedVel = TangentCoord<CoordType::VEL, TangentFrame::NED, Scalar>;
  using NedAccel = TangentCoord<CoordType::ACCEL, TangentFrame::NED, Scalar>;
  using NedAngVel = TangentCoord<CoordType::ANGVEL, TangentFrame::NED, Scalar>;
  using EnuPos = TangentCoord<CoordType::POS, TangentFrame::ENU, Scalar>;
  using EnuVel = TangentCoord<CoordType::VEL, TangentFrame::ENU, Scalar>;
  using EnuAccel = TangentCoord<CoordType::ACCEL, TangentFrame::ENU, Scalar>;
  using EnuAngVel = TangentCoord<CoordType::ANGVEL, TangentFrame::ENU, Scalar>;

 public:
  /**
   * *=== EcefCoord ===*
   * @brief Default constructor. Initializes the vector to zeros.
   */
  explicit EcefCoord()
      : Eigen::Vector3<Scalar>() {
    this->setZero();
  }

  /**
   * *=== EcefCoord ===*
   * @brief Constructor that initializes the vector with given x, y, and z values.
   * @param x The x-component of the vector.
   * @param y The y-component of the vector.
   * @param z The z-component of the vector.
   */
  explicit EcefCoord(Scalar x, Scalar y, Scalar z)
      : Eigen::Vector3<Scalar>(x, y, z) {}

  /**
   * *=== EcefCoord ===*
   * @brief Constructor that initializes the vector from an Eigen::DenseBase object.
   * @tparam Derived The Eigen derived type.
   * @param vector The Eigen vector to copy from.
   */
  template <typename Derived>
  EcefCoord(const Eigen::DenseBase<Derived>& vector)
      : Eigen::Vector3<Scalar>() {
    ASSERT_EIGEN_SCALAR_TYPE(Derived, Scalar);
    ASSERT_EIGEN_VEC_SIZE(Derived, vector, 3);
    this->operator=(vector);
  }

  /**
   * *=== operator= ===*
   * @brief Assignment operator that copies from an Eigen::DenseBase object.
   * @tparam Derived The Eigen derived type.
   * @param other The Eigen vector to copy from.
   * @returns A reference to the current object.
   */
  template <typename Derived>
  EcefCoord& operator=(const Eigen::DenseBase<Derived>& other) {
    this->Eigen::Vector3<Scalar>::operator=(other);
    return *this;
  }

  Scalar& x() { return (*this)(0); }
  Scalar& y() { return (*this)(1); }
  Scalar& z() { return (*this)(2); }
  const Scalar& x() const { return (*this)(0); }
  const Scalar& y() const { return (*this)(1); }
  const Scalar& z() const { return (*this)(2); }

  /**
   * *=== from_eci_pos ===*
   * @brief Converts an ECI position vector to ECEF position.
   * @note This function is only available when `type == CoordType::POS`.
   * @param dt    The time difference between the ECI and ECEF frames.
   * @param r_eci The ECI position vector.
   */
  static auto from_eci_pos(const Scalar dt, const EciPos& r_eci) -> EcefPos
      requires(type == CoordType::POS) {
    return eci2ecef(dt, r_eci);
  }

  /**
   * *=== from_eci_vel ===*
   * @brief Converts an ECI velocity vector to ECEF velocity.
   * @note This function is only available when `type == CoordType::VEL`.
   * @param dt    The time difference between the ECI and ECEF frames.
   * @param v_eci The ECI velocity vector.
   * @param r_eci The ECI position vector (required for the conversion).
   */
  static auto from_eci_vel(const Scalar dt, const EciVel& v_eci, const EciPos& r_eci) -> EcefVel
      requires(type == CoordType::VEL) {
    return eci2ecefv(dt, v_eci, r_eci);
  }

  /**
   * *=== from_eci_accel ===*
   * @brief Converts an ECI acceleration vector to ECEF acceleration.
   * @note This function is only available when `type == CoordType::ACCEL`.
   * @param dt    The time difference between the ECI and ECEF frames.
   * @param a_eci The ECI acceleration vector.
   * @param v_eci The ECI velocity vector (required for the conversion).
   * @param r_eci The ECI position vector (required for the conversion).
   */
  static auto from_eci_accel(
      const Scalar dt, const EciAccel& a_eci, const EciVel& v_eci, const EciPos& r_eci) -> EcefVel
      requires(type == CoordType::ACCEL) {
    return eci2ecefa(dt, a_eci, v_eci, r_eci);
  }

  /**
   * *=== from_eci_angvel ===*
   * @brief Converts an ECI angular velocity vector to ECEF angular velocity.
   * @note This function is only available when `type == CoordType::ANGVEL`.
   * @param dt    The time difference between the ECI and ECEF frames.
   * @param w_eci The ECI angular velocity vector.
   */
  static auto from_eci_angvel(const Scalar dt, const EciAngVel& w_eci) -> EcefAngVel
      requires(type == CoordType::ANGVEL) {
    return eci2ecefw(dt, w_eci);
  }

  /**
   * *=== from_tangent_pos ===*
   * @brief Converts a tangent frame position vector to ECEF position.
   * @note This function is only available when `type == CoordType::POS`.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam degrees True if the lla0 coordinates are in degrees, false for radians.
   * @param r_tangent The position vector in the tangent frame.
   * @param lla0      The latitude, longitude, and altitude of the tangent frame origin.
   */
  template <TangentFrame frame, bool degrees = false>
  static auto from_tangent_pos(
      const TangentCoord<CoordType::POS, frame, Scalar>& r_tangent,
      const GeodeticCoord<degrees, Scalar>& lla0) -> EcefPos requires(type == CoordType::POS) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ned2ecef(r_tangent, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2ecef(r_tangent, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ned2ecef(r_tangent, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2ecef(r_tangent, lla0);
      }
    }
  }
  /**
   * *=== from_tangent_vel ===*
   * @brief Converts a tangent frame velocity vector to ECEF velocity.
   * @note This function is only available when `type == CoordType::VEL`.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam degrees True if the lla0 coordinates are in degrees, false for radians.
   * @param v_tangent The velocity vector in the tangent frame.
   * @param lla0      The latitude, longitude, and altitude of the tangent frame origin.
   */
  template <TangentFrame frame, bool degrees = false>
  static auto from_tangent_vel(
      const TangentCoord<CoordType::VEL, frame, Scalar>& v_tangent,
      const GeodeticCoord<degrees, Scalar>& lla0) -> EcefVel requires(type == CoordType::VEL) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ned2ecefv(v_tangent, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2ecefv(v_tangent, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ned2ecefv(v_tangent, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2ecefv(v_tangent, lla0);
      }
    }
  }

  /**
   * *=== from_tangent_accel ===*
   * @brief Converts a tangent frame acceleration vector to ECEF acceleration.
   * @note This function is only available when `type == CoordType::ACCEL`.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam degrees True if the lla0 coordinates are in degrees, false for radians.
   * @param a_tangent The acceleration vector in the tangent frame.
   * @param lla0      The latitude, longitude, and altitude of the tangent frame origin.
   */
  template <TangentFrame frame, bool degrees = false>
  static auto from_tangent_accel(
      const TangentCoord<CoordType::ACCEL, frame, Scalar>& a_tangent,
      const GeodeticCoord<degrees, Scalar>& lla0) -> EcefAccel requires(type == CoordType::ACCEL) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ned2ecefa(a_tangent, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2ecefa(a_tangent, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ned2ecefa(a_tangent, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2ecefa(a_tangent, lla0);
      }
    }
  }

  /**
   * *=== from_tangent_angvel ===*
   * @brief Converts a tangent frame angular velocity vector to ECEF angular velocity.
   * @note This function is only available when `type == CoordType::ANGVEL`.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam degrees True if the lla0 coordinates are in degrees, false for radians.
   * @param w_tangent The angular velocity vector in the tangent frame.
   * @param lla0      The latitude, longitude, and altitude of the tangent frame origin.
   */
  template <TangentFrame frame, bool degrees = false>
  static auto from_tangent_angvel(
      const TangentCoord<CoordType::ANGVEL, frame, Scalar>& w_tangent,
      const GeodeticCoord<degrees, Scalar>& lla0) -> EcefAngVel requires(type == CoordType::ANGVEL)
  {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ned2ecefw(w_tangent, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2ecefw(w_tangent, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ned2ecefw(w_tangent, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2ecefw(w_tangent, lla0);
      }
    }
  }

  /**
   * *=== from_lla ===*
   * @brief Converts a geodetic position to ECEF position.
   * @note This function is only available when `type == CoordType::POS`.
   * @tparam degrees True if the lla coordinates are in degrees, false for radians.
   * @param lla The geodetic coordinates (latitude, longitude, altitude).
   */
  template <bool degrees = false>
  static auto from_lla(const GeodeticCoord<degrees, Scalar>& lla) -> EcefPos
      requires(type == CoordType::POS) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla_rad;
      lla_rad(0) = lla(0) * D2R<Scalar>;
      lla_rad(1) = lla(1) * D2R<Scalar>;
      lla_rad(2) = lla(2);
      return lla2ecef(lla_rad);
    } else {
      return lla2ecef(lla);
    }
  }

  /**
   * *=== to_eci_pos ===*
   * @brief Converts an ECEF position vector to ECI position.
   * @note This function is only available when `type == CoordType::POS`.
   * @param dt The time difference between the ECEF and ECI frames.
   * @returns The converted ECI position vector.
   */
  auto to_eci_pos(const Scalar dt) const -> EciPos requires(type == CoordType::POS) {
    return ecef2eci(dt, *this);
  }
  /**
   * *=== to_eci_vel ===*
   * @brief Converts an ECEF velocity vector to ECI velocity.
   * @note This function is only available when `type == CoordType::VEL`.
   * @param dt     The time difference between the ECEF and ECI frames.
   * @param r_ecef The ECEF position vector (required for the conversion).
   * @returns The converted ECI velocity vector.
   */
  auto to_eci_vel(const Scalar dt, const EcefPos& r_ecef) const -> EciVel
      requires(type == CoordType::VEL) {
    return ecef2eciv(dt, *this, r_ecef);
  }
  /**
   * *=== to_eci_accel ===*
   * @brief Converts an ECEF acceleration vector to ECI acceleration.
   * @note This function is only available when `type == CoordType::ACCEL`.
   * @param dt     The time difference between the ECEF and ECI frames.
   * @param v_ecef The ECEF velocity vector (required for the conversion).
   * @param r_ecef The ECEF position vector (required for the conversion).
   * @returns The converted ECI acceleration vector.
   */
  auto to_eci_accel(const Scalar dt, const EcefVel& v_ecef, const EcefPos& r_ecef) const -> EciAccel
      requires(type == CoordType::ACCEL) {
    return ecef2ecia(dt, *this, v_ecef, r_ecef);
  }

  /**
   * *=== to_eci_angvel ===*
   * @brief Converts an ECEF angular velocity vector to ECI angular velocity.
   * @note This function is only available when `type == CoordType::ANGVEL`.
   * @param dt The time difference between the ECEF and ECI frames.
   * @returns The converted ECI angular velocity vector.
   */
  auto to_eci_angvel(const Scalar dt) const -> EciAngVel requires(type == CoordType::ANGVEL) {
    return ecef2eciw(dt, *this);
  }

  /**
   * *=== to_tangent_pos ===*
   * @brief Converts an ECEF position vector to a tangent frame position.
   * @note This function is only available when `type == CoordType::POS`.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam degrees True if the returned coordinates should be in degrees, false for radians.
   * @param lla0 The latitude, longitude, and altitude of the tangent frame origin.
   * @returns The converted tangent frame position.
   */
  template <TangentFrame frame, bool degrees = false>
  auto to_tangent_pos(const GeodeticCoord<degrees, Scalar>& lla0) const
      -> TangentCoord<CoordType::POS, frame, Scalar> requires(type == CoordType::POS) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ecef2ned(*this, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return ecef2enu(*this, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ecef2ned(*this, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return ecef2enu(*this, lla0);
      }
    }
  }

  /**
   * *=== to_tangent_vel ===*
   * @brief Converts an ECEF velocity vector to a tangent frame velocity.
   * @note This function is only available when `type == CoordType::VEL`.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam degrees True if the returned coordinates should be in degrees, false for radians.
   * @param lla0 The latitude, longitude, and altitude of the tangent frame origin.
   * @returns The converted tangent frame velocity.
   */
  template <TangentFrame frame, bool degrees = false>
  auto to_tangent_vel(const GeodeticCoord<degrees, Scalar>& lla0) const
      -> TangentCoord<CoordType::VEL, frame, Scalar> requires(type == CoordType::VEL) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ecef2nedv(*this, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return ecef2enuv(*this, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ecef2nedv(*this, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return ecef2enuv(*this, lla0);
      }
    }
  }

  /**
   * *=== to_tangent_accel ===*
   * @brief Converts an ECEF acceleration vector to a tangent frame acceleration.
   * @note This function is only available when `type == CoordType::ACCEL`.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam degrees True if the returned coordinates should be in degrees, false for radians.
   * @param lla0 The latitude, longitude, and altitude of the tangent frame origin.
   * @returns The converted tangent frame acceleration.
   */
  template <TangentFrame frame, bool degrees = false>
  auto to_tangent_accel(const GeodeticCoord<degrees, Scalar>& lla0) const
      -> TangentCoord<CoordType::ACCEL, frame, Scalar> requires(type == CoordType::ACCEL) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ecef2neda(*this, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return ecef2enua(*this, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ecef2neda(*this, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return ecef2enua(*this, lla0);
      }
    }
  }

  /**
   * *=== to_tangent_angvel ===*
   * @brief Converts an ECEF angular velocity vector to a tangent frame angular velocity.
   * @note This function is only available when `type == CoordType::ANGVEL`.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam degrees True if the returned coordinates should be in degrees, false for radians.
   * @param lla0 The latitude, longitude, and altitude of the tangent frame origin.
   * @returns The converted tangent frame angular velocity.
   */
  template <TangentFrame frame, bool degrees = false>
  auto to_tangent_angvel(const GeodeticCoord<degrees, Scalar>& lla0) const
      -> TangentCoord<CoordType::ANGVEL, frame, Scalar> requires(type == CoordType::ANGVEL) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ecef2nedw(*this, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return ecef2enuw(*this, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ecef2nedw(*this, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return ecef2enuw(*this, lla0);
      }
    }
  }

  /**
   * *=== to_lla ===*
   * @brief Converts an ECEF position vector to geodetic coordinates.
   * @note This function is only available when `type == CoordType::POS`.
   * @tparam degrees True if the returned coordinates should be in degrees, false for radians.
   * @returns The converted geodetic coordinates (latitude, longitude, altitude).
   */
  template <bool degrees = false>
  auto to_lla() const -> GeodeticCoord<degrees, Scalar> requires(type == CoordType::POS) {
    GeodeticCoord<false, Scalar> lla_rad;
    ecef2lla(*this, lla_rad);
    if constexpr (degrees) {
      GeodeticCoord<true, Scalar> lla_deg;
      lla_deg(0) = lla_rad(0) * R2D<Scalar>;
      lla_deg(1) = lla_rad(1) * R2D<Scalar>;
      lla_deg(2) = lla_rad(2);
      return lla_deg;
    } else {
      return lla_rad;
    }
  }
};

//! ============================================================================================ !//

template <CoordType type, typename Scalar>
class EciCoord : public Eigen::Vector3<Scalar> {
 private:
  using EcefPos = EcefCoord<CoordType::POS, Scalar>;
  using EcefVel = EcefCoord<CoordType::VEL, Scalar>;
  using EcefAccel = EcefCoord<CoordType::ACCEL, Scalar>;
  using EcefAngVel = EcefCoord<CoordType::ANGVEL, Scalar>;
  using EciPos = EciCoord<CoordType::POS, Scalar>;
  using EciVel = EciCoord<CoordType::VEL, Scalar>;
  using EciAccel = EciCoord<CoordType::ACCEL, Scalar>;
  using EciAngVel = EciCoord<CoordType::ANGVEL, Scalar>;
  using NedPos = TangentCoord<CoordType::POS, TangentFrame::NED, Scalar>;
  using NedVel = TangentCoord<CoordType::VEL, TangentFrame::NED, Scalar>;
  using NedAccel = TangentCoord<CoordType::ACCEL, TangentFrame::NED, Scalar>;
  using NedAngVel = TangentCoord<CoordType::ANGVEL, TangentFrame::NED, Scalar>;
  using EnuPos = TangentCoord<CoordType::POS, TangentFrame::ENU, Scalar>;
  using EnuVel = TangentCoord<CoordType::VEL, TangentFrame::ENU, Scalar>;
  using EnuAccel = TangentCoord<CoordType::ACCEL, TangentFrame::ENU, Scalar>;
  using EnuAngVel = TangentCoord<CoordType::ANGVEL, TangentFrame::ENU, Scalar>;

 public:
  /**
   * *=== EciCoord ===*
   * @brief Default constructor. Initializes the vector to zeros.
   */
  explicit EciCoord()
      : Eigen::Vector3<Scalar>() {
    this->setZero();
  }

  /**
   * *=== EciCoord ===*
   * @brief Constructor that initializes the vector with given x, y, and z values.
   * @param x The x-component of the vector.
   * @param y The y-component of the vector.
   * @param z The z-component of the vector.
   */
  explicit EciCoord(Scalar x, Scalar y, Scalar z)
      : Eigen::Vector3<Scalar>(x, y, z) {}

  /**
   * *=== EciCoord ===*
   * @brief Constructor that initializes the vector from an Eigen::DenseBase object.
   * @tparam Derived The Eigen derived type.
   * @param vector The Eigen vector to copy from.
   */
  template <typename Derived>
  EciCoord(const Eigen::DenseBase<Derived>& vector)
      : Eigen::Vector3<Scalar>() {
    ASSERT_EIGEN_SCALAR_TYPE(Derived, Scalar);
    ASSERT_EIGEN_VEC_SIZE(Derived, vector, 3);
    this->operator=(vector);
  }

  /**
   * *=== operator= ===*
   * @brief Assignment operator that copies from an Eigen::DenseBase object.
   * @tparam Derived The Eigen derived type.
