      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      if constexpr (frame == TangentFrame::NED) {
        return ned2eciw(dt, *this, lla0_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2eciw(dt, *this, lla0_rad);
      }
    } else {
      if constexpr (frame == TangentFrame::NED) {
        return ned2eciw(dt, *this, lla0);
      } else if constexpr (frame == TangentFrame::ENU) {
        return enu2eciw(dt, *this, lla0);
      }
    }
  }

  /**
   * *=== to_lla ===*
   * @brief Converts a tangent frame position to geodetic coordinates.
   * @note This function is only available when `type == CoordType::POS`.
   * @tparam degrees True if the returned coordinates and lla0 are in degrees, false for radians.
   * @param lla0 The geodetic coordinates of the tangent frame origin.
   * @returns The converted geodetic coordinates.
   */
  template <bool degrees = false>
  auto to_lla(const GeodeticCoord<degrees, Scalar>& lla0) const
      -> GeodeticCoord<degrees, Scalar> requires(type == CoordType::POS) {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla0_rad;
      lla0_rad(0) = lla0(0) * D2R<Scalar>;
      lla0_rad(1) = lla0(1) * D2R<Scalar>;
      lla0_rad(2) = lla0(2);
      GeodeticCoord<false, Scalar> lla_rad;
      if constexpr (frame == TangentFrame::NED) {
        ned2lla(*this, lla0_rad, lla_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        enu2lla(*this, lla0_rad, lla_rad);
      }
      GeodeticCoord<true, Scalar> lla_deg;
      lla_deg(0) = lla_rad(0) * R2D<Scalar>;
      lla_deg(1) = lla_rad(1) * R2D<Scalar>;
      lla_deg(2) = lla_rad(2);
      return lla_deg;
    } else {
      GeodeticCoord<false, Scalar> lla_rad;
      if constexpr (frame == TangentFrame::NED) {
        ned2lla(*this, lla0, lla_rad);
      } else if constexpr (frame == TangentFrame::ENU) {
        enu2lla(*this, lla0, lla_rad);
      }
      return lla_rad;
    }
  }
};

//! ============================================================================================ !//

template <bool degrees, typename Scalar>
class GeodeticCoord : public Eigen::Vector3<Scalar> {
 private:
  using EcefPos = EcefCoord<CoordType::POS, Scalar>;
  using EciPos = EciCoord<CoordType::POS, Scalar>;
  using NedPos = TangentCoord<CoordType::POS, TangentFrame::NED, Scalar>;
  using EnuPos = TangentCoord<CoordType::POS, TangentFrame::ENU, Scalar>;

 public:
  /**
   * *=== GeodeticCoord ===*
   * @brief Default constructor. Initializes the geodetic coordinates to zeros.
   */
  explicit GeodeticCoord()
      : Eigen::Vector3<Scalar>() {
    this->setZero();
  }

  /**
   * *=== GeodeticCoord ===*
   * @brief Constructor that initializes the geodetic coordinates with given values.
   * @param lat The latitude.
   * @param lon The longitude.
   * @param alt The altitude.
   */
  explicit GeodeticCoord(Scalar lat, Scalar lon, Scalar alt)
      : Eigen::Vector3<Scalar>(lat, lon, alt) {}

  /**
   * *=== GeodeticCoord ===*
   * @brief Constructor that initializes the coordinates from an Eigen::DenseBase object.
   * @tparam Derived The Eigen derived type.
   * @param vector The Eigen vector to copy from.
   */
  template <typename Derived>
  GeodeticCoord(const Eigen::DenseBase<Derived>& vector)
      : Eigen::Vector3<Scalar>() {
    ASSERT_EIGEN_SCALAR_TYPE(Derived, Scalar);
    ASSERT_EIGEN_VEC_SIZE(Derived, vector, 3);
    this->operator=(vector);
  }

  /**
   * *=== operator= ===*
   * @brief Assignment operator that copies from an Eigen::DenseBase object.
   * @tparam Derived The Eigen derived type.
   * @param other The Eigen vector to copy from.
   * @return A reference to the current object.
   */
  template <typename Derived>
  GeodeticCoord& operator=(const Eigen::DenseBase<Derived>& other) {
    this->Eigen::Vector3<Scalar>::operator=(other);
    return *this;
  }

  Scalar& lat() { return (*this)(0); }
  Scalar& lon() { return (*this)(1); }
  Scalar& alt() { return (*this)(2); }
  const Scalar& lat() const { return (*this)(0); }
  const Scalar& lon() const { return (*this)(1); }
  const Scalar& alt() const { return (*this)(2); }

  /**
   * *=== from_ecef ===*
   * @brief Converts an ECEF position vector to geodetic coordinates.
   * @param r_ecef The ECEF position vector.
   */
  static auto from_ecef(const EcefPos& r_ecef) -> GeodeticCoord<degrees, Scalar> {
    GeodeticCoord<degrees, Scalar> lla;
    ecef2lla(r_ecef, lla);
    if constexpr (degrees) {
      lla(0) *= R2D<Scalar>;
      lla(1) *= R2D<Scalar>;
    }
    return lla;
  }

  /**
   * *=== from_eci ===*
   * @brief Converts an ECI position vector to geodetic coordinates.
   * @param dt The time difference for the transformation.
   * @param r_eci The ECI position vector.
   */
  static auto from_eci(const Scalar dt, const EciPos& r_eci) -> GeodeticCoord<degrees, Scalar> {
    GeodeticCoord<degrees, Scalar> lla;
    eci2lla(dt, r_eci, lla);
    if constexpr (degrees) {
      lla(0) *= R2D<Scalar>;
      lla(1) *= R2D<Scalar>;
    }
    return lla;
  }

  /**
   * *=== from_tangent ===*
   * @brief Converts a tangent frame position vector to geodetic coordinates.
   * @tparam frame The tangent frame (NED or ENU).
   * @param r_tangent The position vector in the tangent frame.
   * @param lla0 The geodetic coordinates of the tangent frame origin.
   */
  template <TangentFrame frame, bool lla0_degrees = false>
  static auto from_tangent(
      const TangentCoord<CoordType::POS, frame, Scalar>& r_tangent,
      const GeodeticCoord<lla0_degrees, Scalar>& lla0) -> GeodeticCoord<degrees, Scalar> {
    GeodeticCoord<degrees, Scalar> lla;
    GeodeticCoord<lla0_degrees, Scalar> lla0_rad = lla0;
    if constexpr (lla0_degrees) {
      lla0_rad(0) *= D2R<Scalar>;
      lla0_rad(1) *= D2R<Scalar>;
    }
    if constexpr (frame == TangentFrame::NED) {
      ned2lla(r_tangent, lla0_rad, lla);
    } else if constexpr (frame == TangentFrame::ENU) {
      enu2lla(r_tangent, lla0_rad, lla);
    }
    if constexpr (degrees) {
      lla(0) *= R2D<Scalar>;
      lla(1) *= R2D<Scalar>;
    }
    return lla;
  }

  /**
   * *=== to_ecef ===*
   * @brief Converts geodetic coordinates to an ECEF position vector.
   * @return The converted ECEF position vector.
   */
  auto to_ecef() const -> EcefPos {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla_rad;
      lla_rad(0) = (*this)(0) * D2R<Scalar>;
      lla_rad(1) = (*this)(1) * D2R<Scalar>;
      lla_rad(2) = (*this)(2);
      return lla2ecef(lla_rad);
    } else {
      return lla2ecef(*this);
    }
  }

  /**
   * *=== to_eci ===*
   * @brief Converts geodetic coordinates to an ECI position vector.
   * @param dt The time difference for the transformation.
   * @return The converted ECI position vector.
   */
  auto to_eci(const Scalar dt) const -> EciPos {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla_rad;
      lla_rad(0) = (*this)(0) * D2R<Scalar>;
      lla_rad(1) = (*this)(1) * D2R<Scalar>;
      lla_rad(2) = (*this)(2);
      return lla2eci(dt, lla_rad);
    } else {
      return lla2eci(dt, *this);
    }
  }

  /**
   * *=== to_tangent ===*
   * @brief Converts geodetic coordinates to a tangent frame position vector.
   * @tparam frame The tangent frame (NED or ENU).
   * @tparam lla0_degrees True if the lla0 coordinates are in degrees, false for radians.
   * @param lla0 The geodetic coordinates of the tangent frame origin.
   * @return The converted tangent frame position vector.
   */
  template <TangentFrame frame, bool lla0_degrees = false>
  auto to_tangent(const GeodeticCoord<lla0_degrees, Scalar>& lla0) const
      -> TangentCoord<CoordType::POS, frame, Scalar> {
    if constexpr (degrees) {
      GeodeticCoord<false, Scalar> lla_rad;
      lla_rad(0) = (*this)(0) * D2R<Scalar>;
      lla_rad(1) = (*this)(1) * D2R<Scalar>;
      lla_rad(2) = (*this)(2);
      if constexpr (lla0_degrees) {
        GeodeticCoord<false, Scalar> lla0_rad;
        lla0_rad(0) = lla0(0) * D2R<Scalar>;
        lla0_rad(1) = lla0(1) * D2R<Scalar>;
        lla0_rad(2) = lla0(2);
        if constexpr (frame == TangentFrame::NED) {
          return lla2ned(lla_rad, lla0_rad);
        } else if constexpr (frame == TangentFrame::ENU) {
          return lla2enu(lla_rad, lla0_rad);
        }
      } else {
        if constexpr (frame == TangentFrame::NED) {
          return lla2ned(lla_rad, lla0);
        } else if constexpr (frame == TangentFrame::ENU) {
          return lla2enu(lla_rad, lla0);
        }
      }
    } else {
      if constexpr (lla0_degrees) {
        GeodeticCoord<false, Scalar> lla0_rad;
        lla0_rad(0) = lla0(0) * D2R<Scalar>;
        lla0_rad(1) = lla0(1) * D2R<Scalar>;
        lla0_rad(2) = lla0(2);
        if constexpr (frame == TangentFrame::NED) {
          return lla2ned(*this, lla0_rad);
        } else if constexpr (frame == TangentFrame::ENU) {
          return lla2enu(*this, lla0_rad);
        }
      } else {
        if constexpr (frame == TangentFrame::NED) {
          return lla2ned(*this, lla0);
        } else if constexpr (frame == TangentFrame::ENU) {
          return lla2enu(*this, lla0);
        }
      }
    }
  }
};

