template <typename Scalar = double, RotationOrder order = RotationOrder::ZYX>
class EulerAngles;

template <typename Scalar = double>
class RotationMatrix;

template <typename Scalar = double>
class Quaternion;

//! ============================================================================================ !//

/**
 * @class EulerAngles
 * @brief A templated class for representing 3D rotations using Euler angles.
 * It inherits from Eigen::Vector3, providing seamless integration with Eigen's
 * linear algebra functionalities.
 * @tparam Scalar The underlying floating-point type (e.g., float, double).
 */
template <typename Scalar, RotationOrder order>
class EulerAngles : public Eigen::Vector3<Scalar> {
 public:
  /**
   * *=== EulerAngles ===*
   * @brief Default constructor. Initializes angles to zero.
   */
  explicit EulerAngles() noexcept
      : Eigen::Vector3<Scalar>() {
    this->setZero();
  }

  /**
   * *=== EulerAngles ===*
   * @brief Constructs with explicit roll, pitch, and yaw values.
   * @param roll The rotation angle about the first axis.
   * @param pitch The rotation angle about the second axis.
   * @param yaw The rotation angle about the third axis.
   */
  explicit EulerAngles(Scalar roll, Scalar pitch, Scalar yaw) noexcept
      : Eigen::Vector3<Scalar>(roll, pitch, yaw) {
    this->normalize();
  }

  /**
   * *=== EulerAngles ===*
   * @brief Constructs from an Eigen dense vector.
   * @tparam Derived The derived type of the Eigen vector.
   * @param vector The Eigen vector containing the three angles.
   */
  template <typename Derived>
  EulerAngles(const Eigen::DenseBase<Derived>& vector)
      : Eigen::Vector3<Scalar>() {
    ASSERT_EIGEN_VEC_SIZE(Derived, vector, 3);
    ASSERT_EIGEN_SCALAR_TYPE(Derived, Scalar);
    *this = vector.derived();
    this->normalize();
  }

  EulerAngles(const RotationMatrix<Scalar>& dcm)
      : Eigen::Vector3<Scalar>() {
    *this = from_dcm(dcm);
  }

  EulerAngles(const Quaternion<Scalar>& q)
      : Eigen::Vector3<Scalar>() {
    *this = from_quat(q);
  }

  /**
   * *=== operator= ===*
   * @brief Assignment operator from an Eigen dense vector.
   * @tparam Derived The derived type of the Eigen vector.
   * @param other The Eigen vector to assign from.
   * @return A reference to the EulerAngles object.
   */
  template <typename Derived>
  EulerAngles& operator=(const Eigen::DenseBase<Derived>& other) {
    ASSERT_EIGEN_SCALAR_TYPE(Derived, Scalar);
    this->Eigen::Vector3<Scalar>::operator=(other);
    return *this;
  }

  // Named accessors for clarity
  Scalar& roll() { return (*this)(0); }
  Scalar& pitch() { return (*this)(1); }
  Scalar& yaw() { return (*this)(2); }
  const Scalar& roll() const { return (*this)(0); }
  const Scalar& pitch() const { return (*this)(1); }
  const Scalar& yaw() const { return (*this)(2); }

  /**
   * *=== normalize ===*
   * @brief Normalizes the angles to the range $[-\pi, \pi)$.
   */
  void normalize() {
    auto WrapAngle = [](Scalar x, Scalar y) {
      Scalar half_y = 0.5 * y;
      return x - std::floor((x + half_y) / y) * y;
    };

    if constexpr ((order == RotationOrder::YXZ) || (order == RotationOrder::ZXY)) {
      this->roll() = WrapAngle(this->roll(), PI<Scalar>);
      this->pitch() = WrapAngle(this->pitch(), TWO_PI<Scalar>);
      this->yaw() = WrapAngle(this->yaw(), TWO_PI<Scalar>);
    } else if constexpr ((order == RotationOrder::XYZ) || (order == RotationOrder::ZYX)) {
      this->roll() = WrapAngle(this->roll(), TWO_PI<Scalar>);
      this->pitch() = WrapAngle(this->pitch(), PI<Scalar>);
      this->yaw() = WrapAngle(this->yaw(), TWO_PI<Scalar>);
    } else if constexpr ((order == RotationOrder::XZY) || (order == RotationOrder::YZX)) {
      this->roll() = WrapAngle(this->roll(), TWO_PI<Scalar>);
      this->pitch() = WrapAngle(this->pitch(), TWO_PI<Scalar>);
      this->yaw() = WrapAngle(this->yaw(), PI<Scalar>);
    } else if constexpr (
        (order == RotationOrder::XYX) || (order == RotationOrder::XZX) ||
        (order == RotationOrder::YXY) || (order == RotationOrder::YZY) ||
        (order == RotationOrder::ZXZ) || (order == RotationOrder::ZYZ)) {
      this->roll() = WrapAngle(this->roll(), TWO_PI<Scalar>);
      this->pitch() = WrapAngle(this->pitch(), PI<Scalar>);
      this->yaw() = WrapAngle(this->yaw(), TWO_PI<Scalar>);
    }
  }

  /**
   * *=== from_dcm ===*
   * @brief Converts a Direction Cosine Matrix to this EulerAngles object in-place.
   * @tparam order The rotation order (e.g., ZYX, XYZ).
   * @param dcm The Direction Cosine Matrix to convert from.
   */
  static EulerAngles<Scalar> from_dcm(const RotationMatrix<Scalar>& dcm) {
    return dcm2euler<order, EulerAngles<Scalar, order>>(dcm);
  }

  /**
   * *=== from_quat ===*
   * @brief Converts a Quaternion to this EulerAngles object in-place.
   * @tparam order The rotation order (e.g., ZYX, XYZ).
   * @param q The Quaternion to convert from.
   */
  static EulerAngles<Scalar> from_quat(const Quaternion<Scalar>& q) {
    return quat2euler<order, EulerAngles<Scalar, order>>(q);
  }

  /**
   * *=== to_dcm===*
   * @brief Converts the Euler angles to a Direction Cosine Matrix.
   * @tparam order The rotation order (e.g., ZYX, XYZ).
   * @return The resulting Direction Cosine Matrix.
   */
  RotationMatrix<Scalar> to_dcm() const { return euler2dcm<order, RotationMatrix<Scalar>>(*this); }

  /**
   * *=== to_quat ===*
   * @brief Converts the Euler angles to a Quaternion.
   * @tparam order The rotation order (e.g., ZYX, XYZ).
   * @return The resulting Quaternion.
   */
  Quaternion<Scalar> to_quat() const { return euler2quat<order, Quaternion<Scalar>>(*this); }
};

//! ============================================================================================ !//

/**
 * @class RotationMatrix
 * @brief A templated class for representing 3D rotations using a 3x3 matrix.
 * It inherits from Eigen::Matrix3, providing full matrix functionality.
 * @tparam Scalar The underlying floating-point type (e.g., float, double).
 */
template <typename Scalar>
class RotationMatrix : public Eigen::Matrix3<Scalar> {
 public:
  /**
   * *=== RotationMatrix ===*
   * @brief Default constructor. Initializes to zero matrix.
   */
  explicit RotationMatrix() noexcept
      : Eigen::Matrix3<Scalar>() {
    this->setZero();
  }

  /**
   * *=== RotationMatrix ===*
   * @brief Constructs from an Eigen dense matrix. Normalizes the matrix.
   * @tparam Derived The derived type of the Eigen matrix.
   * @param matrix The Eigen matrix to construct from.
   */
  template <typename Derived>
  RotationMatrix(const Eigen::DenseBase<Derived>& matrix)
      : Eigen::Matrix3<Scalar>() {
    ASSERT_EIGEN_MAT_SIZE(Derived, matrix, 3, 3);
    ASSERT_EIGEN_SCALAR_TYPE(Derived, Scalar);
    *this = matrix.derived();
    this->normalize();
  }

  /**
   * *=== RotationMatrix ===*
   * @brief Constructs from Euler Angles.
   * @tparam order The rotation order (e.g., ZYX, XYZ).
   * @param e The EulerAngles object to construct from.
   */
  template <RotationOrder order>
  explicit RotationMatrix(const EulerAngles<Scalar, order>& e)
      : Eigen::Matrix3<Scalar>() {
    *this = from_euler<order>(e);
  }

  /**
   * *=== RotationMatrix ===*
   * @brief Constructs from a Quaternion.
   * @param q The Quaternion object to construct from.
   */
  explicit RotationMatrix(const Quaternion<Scalar>& q)
      : Eigen::Matrix3<Scalar>() {
    *this = from_quat(q);
  }

  /**
   * *=== operator= ===*
   * @brief Assignment operator from an Eigen dense matrix.
   * @tparam Derived The derived type of the Eigen matrix.
   * @param other The Eigen matrix to assign from.
   * @return A reference to the RotationMatrix object.
   */
  template <typename Derived>
  RotationMatrix& operator=(const Eigen::DenseBase<Derived>& other) {
    ASSERT_EIGEN_SCALAR_TYPE(Derived, Scalar);
    this->Eigen::Matrix3<Scalar>::operator=(other);
    return *this;
  }

  /**
   * *=== normalize ===*
   * @brief Normalizes the matrix to ensure it is a valid rotation matrix (orthonormal).
   * Implements a Gram-Schmidt orthogonalization process.
   */
  void normalize() {
    this->col(0).normalize();
    this->col(1) -= this->col(1).dot(this->col(0)) * this->col(0);
    this->col(1).normalize();
    this->col(2) = this->col(0).cross(this->col(1));
  }

  /**
   * *=== normalized ===*
   * @brief Returns a normalized copy of the matrix.
   * @return A normalized RotationMatrix object.
   */
  RotationMatrix<Scalar> normalized() const {
    RotationMatrix<Scalar> out = *this;
    out.normalize();
    return out;
  }

  /**
   * *=== from_euler ===*
   * @brief Converts Euler Angles to a Direction Cosine Matrix in-place.
   * @tparam order The rotation order (e.g., ZYX, XYZ).
   * @param e The EulerAngles object to convert from.
   */
  template <RotationOrder order>
  static RotationMatrix<Scalar> from_euler(const EulerAngles<Scalar, order>& e) {
    return euler2dcm<order, RotationMatrix<Scalar>>(e);
  }

  /**
   * *=== from_quat ===*
   * @brief Converts a Quaternion to a Direction Cosine Matrix in-place.
   * @param q The Quaternion object to convert from.
   */
  static RotationMatrix<Scalar> from_quat(const Quaternion<Scalar>& q) {
    return quat2dcm<RotationMatrix<Scalar>>(q);
  }

  /**
   * *=== identity ===*
   * @brief Creates a static identity matrix.
   * @return An identity RotationMatrix object.
   */
  static RotationMatrix identity() {
    RotationMatrix identity;
    identity.setIdentity();
    return identity;
  }

  /**
   * *=== to_euler ===*
   * @brief Converts the Direction Cosine Matrix to Euler Angles.
   * @tparam order The rotation order (e.g., ZYX, XYZ).
   * @return The resulting EulerAngles object.
   */
  template <RotationOrder order>
  EulerAngles<Scalar> to_euler() const {
    return dcm2euler<order, EulerAngles<Scalar>>(*this);
  }

  /**
   * *=== to_quat ===*
   * @brief Converts the Direction Cosine Matrix to a Quaternion.
   * @return The resulting Quaternion object.
   */
  Quaternion<Scalar> to_quat() const {  //
    return dcm2quat<Quaternion<Scalar>>(*this);
  }
};

